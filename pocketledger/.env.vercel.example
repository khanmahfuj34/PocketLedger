# ==============================================================================
# POCKETLEDGER — VERCEL SERVERLESS ENVIRONMENT VARIABLES
# ==============================================================================
# Configure these in: Vercel Project Settings -> Environment Variables

APP_NAME=PocketLedger
APP_ENV=production
APP_KEY=base64:YOUR_GENERATED_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://your-pocketledger.vercel.app
APP_TIMEZONE=Asia/Dhaka

# ------------------------------------------------------------------------------
# SERVERLESS RUNTIME OVERRIDES (Stateless / Read-Only Filesystem)
# ------------------------------------------------------------------------------
# In serverless, logs must go to stderr to appear in Vercel runtime logs
LOG_CHANNEL=stderr

# Session Driver:
# 'cookie': Stateless, signed/encrypted in client cookie (no DB overhead).
# 'database': Shared in TiDB `sessions` table (works seamlessly with Tokyo hnd1 region).
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Cache: In-memory array cache for single-request lifecycle
CACHE_STORE=array

# Queue: Synchronous (daemons cannot run on Vercel serverless)
QUEUE_CONNECTION=sync

# ------------------------------------------------------------------------------
# TIDB CLOUD DATABASE CONNECTION (Tokyo ap-northeast-1 / Vercel hnd1)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=pocketledger_db
DB_USERNAME=your_tidb_username
DB_PASSWORD=your_tidb_password

# SSL CA: Relative path to certificate committed in repository
MYSQL_ATTR_SSL_CA=certs/isrgrootx1.pem
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true

# ------------------------------------------------------------------------------
# PERSISTENT ATTACHMENT / RECEIPT STORAGE (Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
# Required for user receipt uploads (local storage is deleted on Lambda shutdown)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=your_r2_or_s3_key
AWS_SECRET_ACCESS_KEY=your_r2_or_s3_secret
AWS_DEFAULT_REGION=auto
AWS_BUCKET=pocketledger-receipts
AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

