{
  "version": 2,
  "framework": null,
  "regions": ["hnd1"],
  "buildCommand": "cd pocketledger && php -r \"file_exists('composer.phar') || copy('https://getcomposer.org/composer.phar', 'composer.phar');\" && php composer.phar install --no-dev --prefer-dist --optimize-autoloader --no-interaction && npm run build",
  "outputDirectory": "pocketledger/public",
  "functions": {
    "pocketledger/api/index.php": {
      "runtime": "vercel-php@0.7.3",
      "maxDuration": 10,
      "includeFiles": "pocketledger/**"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/pocketledger/public/build/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/pocketledger/api/index.php"
    }
  ]
}
