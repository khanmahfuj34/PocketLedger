{
  "version": 2,
  "framework": null,
  "regions": ["hnd1"],
  "builds": [
    {
      "src": "pocketledger/api/index.php",
      "use": "vercel-php@0.7.3",
      "config": {
        "maxDuration": 10
      }
    },
    {
      "src": "pocketledger/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "public"
      }
    }
  ],
  "routes": [
    {
      "src": "/build/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/pocketledger/public/build/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/pocketledger/api/index.php"
    }
  ]
}

